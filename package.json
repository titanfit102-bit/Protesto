{
  "name": "protesto",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Privacy-first civic accountability demo and private PostgreSQL pilot",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "pilot": "node tools/pilot-server.mjs",
    "db:migrate": "node tools/migrate.mjs",
    "db:user": "node tools/provision-user.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node tools/check.mjs",
    "verify": "npm run check && npm test",
    "test:e2e": "node test/browser.e2e.mjs && node test/dialogue.browser.e2e.mjs",
    "db:backup": "node tools/backup.mjs",
    "db:restore-test": "node tools/restore.mjs",
    "test:backup": "node test/backup.integration.mjs",
    "db:verify-backup": "node tools/verify-backup.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "puppeteer-core": "^25.15.0"
  }
}
